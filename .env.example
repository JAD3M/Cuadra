# .env.example
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cuadra:cuadra@postgres:5432/cuadra
DATABASE_APP_URL=postgresql://cuadra_app:cuadra_app@postgres:5432/cuadra
REDIS_URL=redis://redis:6379
ORIGEN_AUTORIZADO=http://localhost:5173
# CU-08: reintentos de la cola (backoff exponencial desde COLA_ESPERA_MS)
COLA_INTENTOS=5
COLA_ESPERA_MS=1000
COLA_PREFIJO=cuadra
# CU-17: sugerencia por IA. Con el proveedor real (anthropic) solo funciona
# con LLM_HABILITADO=true Y una llave; nunca subas la llave al repositorio.
# Aquí queda activa para la demo con el proveedor simulado (bloque al final).
LLM_HABILITADO=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=15000
LLM_MAX_LLAMADAS_POR_CORRIDA=20
LLM_CANDIDATOS_MAX=10

# Demo (CU-18): IA simulada, sin llave y sin red. `npm run demo` espera
# LLM_HABILITADO=true y LLM_PROVEEDOR=simulado. El valor simulado se RECHAZA
# con NODE_ENV=production. Para el modelo real (de pago): LLM_PROVEEDOR=anthropic
# y ANTHROPIC_API_KEY arriba.
LLM_PROVEEDOR=simulado
