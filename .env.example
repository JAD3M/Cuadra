# .env.example
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cuadra:cuadra@postgres:5432/cuadra
DATABASE_APP_URL=postgresql://cuadra_app:cuadra_app@postgres:5432/cuadra
REDIS_URL=redis://redis:6379
JWT_SECRET=cambiar-en-produccion
# CU-08: reintentos de la cola (backoff exponencial desde COLA_ESPERA_MS)
COLA_INTENTOS=5
COLA_ESPERA_MS=1000
COLA_PREFIJO=cuadra
# CU-17: sugerencia por IA. Apagada por omisión; activa solo con
# LLM_HABILITADO=true Y una llave. Nunca subas la llave al repositorio.
LLM_HABILITADO=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=15000
LLM_MAX_LLAMADAS_POR_CORRIDA=20
LLM_CANDIDATOS_MAX=10
