# .env.example
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cuadra:cuadra@postgres:5432/cuadra
DATABASE_APP_URL=postgresql://cuadra_app:cuadra_app@postgres:5432/cuadra
REDIS_URL=redis://redis:6379
JWT_SECRET=cambiar-en-produccion
# CU-08: reintentos de la cola (backoff exponencial desde COLA_ESPERA_MS)
COLA_INTENTOS=5
COLA_ESPERA_MS=1000
COLA_PREFIJO=cuadra
